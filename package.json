{
  "name": "transcriber",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "cli": "pnpm --filter @bryan-gc/transcribe-cli",
    "start": "pnpm cli start",
    "try": "pnpm cli try",
    "try:mock": "pnpm cli try:mock",
    "try:local": "pnpm cli try:local",
    "try:doctor": "pnpm cli try:doctor",
    "try:global": "pnpm cli try:global",
    "sandbox:clean": "rm -rf .sandbox",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm cli test:watch",
    "lint": "eslint . --max-warnings 119",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write '**/*.{ts,tsx,js,mjs,json}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,mjs,json}'",
    "release": "cd apps/cli && pnpm version",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "~5.24.7",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
