# Development-only settings, loaded by the npm scripts via Node's --env-file-if-exists.
# The published CLI never reads this file: it uses ~/.transcribe-cli/config.json.
# Copy to .env and fill in only what you need. .env is gitignored.
#
# Never put the API key here. The dev scripts (start, try, try:doctor) run through
# `fnox exec`, which injects OPENAI_API_KEY from the system keychain (see fnox.toml).

# Writes recordings and transcriptions somewhere disposable instead of your real
# base path, so testing does not mix with what you have already recorded.
TRANSCRIBE_BASE_PATH=

# Returns canned text instead of calling any engine. No network, no credits.
TRANSCRIBE_MOCK=0

# openai | local - try an engine without changing the saved configuration.
TRANSCRIBE_ENGINE=

# es | en | pt | fr | de
TRANSCRIBE_LANGUAGE=

# Absolute paths, when a binary is installed somewhere PATH does not reach.
TRANSCRIBE_FFMPEG_PATH=
TRANSCRIBE_WHISPERX_PATH=
