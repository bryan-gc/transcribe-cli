# Development-only settings, loaded by the npm scripts via Node's --env-file-if-exists.
# The published CLI never reads this file: it uses ~/.transcribe-cli/config.json.
# Copy to .env and fill in. .env is gitignored.

# Overrides the OpenAI key from the config file. Useful for the manual audio checks
# and for regenerating the JSON fixtures without touching your real configuration.
OPENAI_API_KEY=

# HuggingFace token, required only by the local diarization pipeline (--local --speakers).
# Create it at huggingface.co/settings/tokens and accept the terms of the gated
# pyannote models it downloads on first run.
HF_TOKEN=

# Writes recordings and transcriptions somewhere disposable instead of your real
# base path, so development does not pollute the archive.
TRANSCRIBE_BASE_PATH=

# Returns canned fixtures instead of calling any transcription engine.
TRANSCRIBE_MOCK=0

# openai | local — try an engine without changing the saved configuration.
TRANSCRIBE_ENGINE=

# Absolute paths, when a binary is installed somewhere outside PATH.
TRANSCRIBE_FFMPEG_PATH=
TRANSCRIBE_PYTHON_PATH=
