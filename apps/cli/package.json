{
  "name": "@bryan-gc/transcribe-cli",
  "version": "1.3.1",
  "description": "CLI tool to record audio and transcribe it using OpenAI Whisper",
  "main": "dist/index.js",
  "bin": {
    "transcribe-cli": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bryan-gc/transcribe-cli",
    "directory": "apps/cli"
  },
  "type": "module",
  "scripts": {
    "start": "fnox exec -- node --env-file-if-exists=../../.env --import tsx src/index.tsx",
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit && tsc -p tests",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/**/*.test.ts",
    "try": "fnox exec -- env TRANSCRIBE_BASE_PATH=$PWD/../../.sandbox node --env-file-if-exists=../../.env --import tsx src/index.tsx",
    "try:mock": "TRANSCRIBE_MOCK=1 TRANSCRIBE_BASE_PATH=$PWD/../../.sandbox node --env-file-if-exists=../../.env --import tsx src/index.tsx",
    "try:local": "TRANSCRIBE_ENGINE=local TRANSCRIBE_BASE_PATH=$PWD/../../.sandbox node --env-file-if-exists=../../.env --import tsx src/index.tsx",
    "try:doctor": "fnox exec -- node --env-file-if-exists=../../.env --import tsx src/index.tsx doctor --all",
    "try:global": "pnpm build && npm link && transcribe-cli doctor"
  },
  "keywords": [
    "cli",
    "transcribe",
    "openai",
    "whisper",
    "audio"
  ],
  "author": "bryan-gc",
  "license": "ISC",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "commander": "^14.0.3",
    "ink": "^7.0.3",
    "ink-spinner": "^5.0.0",
    "openai": "^6.37.0",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
